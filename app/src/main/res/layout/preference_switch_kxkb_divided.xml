<?xml version="1.0" encoding="utf-8"?>
<!-- 白い熊 kxkb settings switch row that OPENS a divider block: the full-width yellow separator line of a
     category header, then a normal indented item row with the switch in the widget frame. Used for the
     "Apply to all keyboards" toggle, which shares its block with the Geometry heading below it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp">

    <!-- Full-width hairline separator between this block and the previous one (1px = thinnest possible). -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/kxkb_yellow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground"
        android:minHeight="0dp"
        android:paddingStart="72dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@android:id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/kxkb_yellow"
                android:textSize="16sp" />

            <TextView
                android:id="@android:id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/kxkb_yellow_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@android:id/widget_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
