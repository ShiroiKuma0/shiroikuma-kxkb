<?xml version="1.0" encoding="utf-8"?>
<!-- 白い熊 kxkb settings category header: a FULL-WIDTH yellow separator line above the group (the
     between-categories border), then a big bold yellow heading with a WORD-WIDTH yellow underline. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="2dp">

    <!-- Full-width hairline separator between this group and the previous one (1px = thinnest possible). -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/kxkb_yellow" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/kxkb_yellow"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp"
            android:background="@color/kxkb_yellow" />
    </LinearLayout>
</LinearLayout>
