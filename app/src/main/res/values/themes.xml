<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 白い熊 kxkb app shell: black background, yellow text, yellow accents/borders everywhere
         (Settings, menus, dialogs). The keyboard itself is themed separately via HighContrastYellow. -->
    <style name="Theme.Urik" parent="Theme.Material3.Dark">
        <item name="colorPrimary">@color/kxkb_yellow</item>
        <item name="colorOnPrimary">@color/kxkb_black</item>
        <item name="colorPrimaryContainer">@color/kxkb_surface_dark</item>
        <item name="colorOnPrimaryContainer">@color/kxkb_yellow</item>

        <item name="colorSecondary">@color/kxkb_yellow</item>
        <item name="colorOnSecondary">@color/kxkb_black</item>
        <item name="colorSecondaryContainer">@color/kxkb_surface_dark</item>
        <item name="colorOnSecondaryContainer">@color/kxkb_yellow</item>

        <item name="colorTertiary">@color/kxkb_yellow</item>
        <item name="colorOnTertiary">@color/kxkb_black</item>

        <item name="colorSurface">@color/kxkb_black</item>
        <item name="colorOnSurface">@color/kxkb_yellow</item>
        <item name="colorSurfaceVariant">@color/kxkb_surface_dark</item>
        <item name="colorOnSurfaceVariant">@color/kxkb_yellow_dim</item>
        <item name="colorSurfaceContainer">@color/kxkb_black</item>
        <item name="colorSurfaceContainerHigh">@color/kxkb_surface_dark</item>
        <item name="colorSurfaceContainerHighest">@color/kxkb_surface_dark</item>

        <item name="colorOutline">@color/kxkb_yellow</item>
        <item name="colorOutlineVariant">@color/kxkb_yellow_dim</item>
        <item name="colorControlNormal">@color/kxkb_yellow</item>

        <item name="android:windowBackground">@color/kxkb_black</item>
        <item name="android:colorBackground">@color/kxkb_black</item>
        <item name="android:textColorPrimary">@color/kxkb_yellow</item>
        <item name="android:textColorSecondary">@color/kxkb_yellow_dim</item>
        <item name="android:textColorTertiary">@color/kxkb_yellow_dim</item>

        <!-- Route EVERY AlertDialog spawned from a Settings activity (ListPreference pickers, plain
             AlertDialog.Builder(this), etc.) through our black/yellow dialog, so none falls back to the
             default grey Material dialog. Dialogs that pass Theme.Urik.Dialog explicitly are unaffected. -->
        <item name="alertDialogTheme">@style/Theme.Urik.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Urik.Dialog</item>
    </style>

    <style name="Theme.Urik.NoActionBar" parent="Theme.Urik">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Black/yellow dialog: black fill, yellow border, yellow title/text, yellow outlined buttons. -->
    <style name="Theme.Urik.Dialog" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="colorPrimary">@color/kxkb_yellow</item>
        <item name="colorSurface">@color/kxkb_black</item>
        <item name="colorOnSurface">@color/kxkb_yellow</item>
        <item name="colorOnSurfaceVariant">@color/kxkb_yellow</item>
        <item name="colorSurfaceContainerHigh">@color/kxkb_black</item>
        <item name="android:textColorPrimary">@color/kxkb_yellow</item>
        <item name="android:textColorSecondary">@color/kxkb_yellow</item>
        <!-- The single-/multi-choice list items + their radio/check indicator: yellow text, yellow circle. -->
        <item name="android:textColorAlertDialogListItem">@color/kxkb_yellow</item>
        <item name="colorControlNormal">@color/kxkb_yellow</item>
        <item name="colorControlActivated">@color/kxkb_yellow</item>
        <item name="android:colorControlNormal">@color/kxkb_yellow</item>
        <item name="android:colorControlActivated">@color/kxkb_yellow</item>
        <item name="android:windowBackground">@drawable/kxkb_dialog_bg</item>
        <item name="buttonBarPositiveButtonStyle">@style/Theme.Urik.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Theme.Urik.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Theme.Urik.Dialog.Button</item>
    </style>

    <style name="Theme.Urik.Dialog.Button" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/kxkb_yellow</item>
        <item name="strokeColor">@color/kxkb_yellow</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="rippleColor">@color/kxkb_yellow_dim</item>
    </style>
</resources>