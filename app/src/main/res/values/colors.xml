<resources>
    <!-- ============================================ -->
    <!-- CORE PALETTE -->
    <!-- ============================================ -->
    <color name="light_orange">#fcdebe</color>
    <color name="sage">#d4d2a5</color>
    <color name="battleship_gray">#928779</color>
    <color name="wenge">#5e5768</color>
    <color name="delft_blue">#3a445d</color>

    <!-- ============================================ -->
    <!-- SURFACE COLORS (inverted hierarchy) -->
    <!-- ============================================ -->
    <!-- App-shell chrome (MainActivity / About / feature sheet) — now black/yellow (kxkb).
         The live keyboard is themed separately via ThemeColors, so these don't affect it. -->
    <color name="surface_primary">@color/kxkb_black</color>
    <color name="surface_secondary">@color/kxkb_surface_dark</color>
    <color name="surface_background">@color/kxkb_black</color>

    <!-- ============================================ -->
    <!-- CONTENT COLORS (yellow text on black) -->
    <!-- ============================================ -->
    <color name="content_primary">@color/kxkb_yellow</color>
    <color name="content_secondary">@color/kxkb_yellow_dim</color>
    <color name="content_on_accent">@color/kxkb_black</color>

    <!-- ============================================ -->
    <!-- INTERACTIVE STATES -->
    <!-- ============================================ -->

    <!-- ============================================ -->
    <!-- KEYBOARD COLORS -->
    <!-- ============================================ -->

    <!-- Backgrounds -->
    <color name="keyboard_background">@color/surface_background</color>
    <color name="key_background_character">@color/surface_primary</color>
    <color name="key_background_action">@color/surface_secondary</color>

    <!-- Text Colors -->
    <color name="key_text_character">@color/content_primary</color>
    <color name="key_text_action">@color/content_secondary</color>

    <!-- Borders -->
    <color name="key_border">@color/battleship_gray</color>

    <!-- ============================================ -->
    <!-- SUGGESTION BAR -->
    <!-- ============================================ -->

    <!-- ============================================ -->
    <!-- ACCESSIBILITY & SHADOWS -->
    <!-- ============================================ -->

    <!-- ============================================ -->
    <!-- LEGACY COMPATIBILITY -->
    <!-- ============================================ -->

    <!-- ============================================ -->
    <!-- 白い熊 kxkb black/yellow app-shell palette (Settings, menus, dialogs) -->
    <!-- ============================================ -->
    <color name="kxkb_black">#000000</color>
    <color name="kxkb_yellow">#FFFF00</color>
    <color name="kxkb_yellow_dim">#C8C800</color>
    <color name="kxkb_surface_dark">#0A0A00</color>
</resources>
